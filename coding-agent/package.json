{
  "name": "coding-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --experimental-strip-types agent.ts",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "eval:swebench:preflight": "node --experimental-strip-types eval/swebench/preflight.ts --json",
    "eval:swebench:run": "node --experimental-strip-types scripts/swebench/run_task.ts",
    "eval:swebench:grade": "node --experimental-strip-types scripts/swebench/grade_task.ts",
    "eval:swebench:batch": "node --experimental-strip-types scripts/swebench/batch_task.ts",
    "eval:swebench:pi": "node --experimental-strip-types scripts/swebench/pi_task.ts",
    "eval:swebench:pi-batch": "node --experimental-strip-types scripts/swebench/pi_batch_task.ts",
    "eval:ui": "node --experimental-strip-types eval/ui/server.ts",
    "test:sandbox": "RUN_MACOS_SANDBOX_TESTS=1 node --experimental-strip-types --test tests/macos_sandbox.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "diff": "^9.0.0",
    "openai": "^6.45.0",
    "smol-toml": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  }
}
