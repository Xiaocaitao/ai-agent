{
  "permissions": {
    "edit_file": "ask",
    "run_command": "ask",
    "read_file": "allow",
    "write_file": "ask",
    "search_files": "allow"
  },
  "tools": [
    {
      "name": "run_command",
      "module": "tools.run_command",
      "function": "run_command",
      "description": "运行一次非 Shell 终端命令，可提供标准输入，返回 stdout、stderr 和退出码。",
      "parameters": {
        "type": "object",
        "properties": {
          "args": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "description": "命令及参数数组，例如 [\"python\", \"-m\", \"unittest\"]"
          },
          "stdin": {"type": "string", "description": "可选标准输入"},
          "cwd": {"type": "string", "minLength": 1, "description": "工作区内的执行目录"},
          "timeout": {"type": "integer", "minimum": 1, "maximum": 120}
        },
        "required": ["args"],
        "additionalProperties": false
      }
    },
    {
      "name": "read_file",
      "module": "tools.read_file",
      "function": "read_file",
      "description": "读取工作区内 UTF-8 文本文件的指定行范围。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1, "description": "工作区相对路径"},
          "start_line": {"type": "integer", "minimum": 1},
          "max_lines": {"type": "integer", "minimum": 1}
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    {
      "name": "write_file",
      "module": "tools.write_file",
      "function": "write_file",
      "description": "创建或完整覆盖工作区内的 UTF-8 文本文件。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1, "description": "工作区相对路径"},
          "content": {"type": "string", "description": "完整文件内容"}
        },
        "required": ["path", "content"],
        "additionalProperties": false
      }
    },
    {
      "name": "edit_file",
      "module": "tools.edit_file",
      "function": "edit_file",
      "description": "精确替换工作区内现有 UTF-8 文本文件中的唯一文本。old_text 必须只出现一次；创建文件请使用 write_file。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1, "description": "工作区相对路径"},
          "old_text": {"type": "string", "minLength": 1, "description": "文件中必须唯一存在的原文本"},
          "new_text": {"type": "string", "description": "替换后的新文本，可以为空字符串"}
        },
        "required": ["path", "old_text", "new_text"],
        "additionalProperties": false
      }
    },
    {
      "name": "search_files",
      "module": "tools.search_files",
      "function": "search_files",
      "description": "递归搜索工作区文本文件中的普通字符串。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "minLength": 1, "description": "大小写敏感的搜索文本"},
          "path": {"type": "string", "minLength": 1, "description": "工作区内的搜索目录"},
          "pattern": {"type": "string", "minLength": 1, "description": "文件名 glob，例如 *.py"}
        },
        "required": ["query"],
        "additionalProperties": false
      }
    }
  ]
}
